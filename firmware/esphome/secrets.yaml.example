# secrets.yaml.example — copy to secrets.yaml and fill in real values.
#
#   cp secrets.yaml.example secrets.yaml
#
# secrets.yaml is gitignored (this repo has a PUBLIC mirror — never commit it).
# The USB smoke test (coach-terminal-smoketest.yaml) needs NONE of these; they
# are only required by the full coach-terminal.yaml once you wire wifi.
#
# Generate the api encryption key (32-byte base64):
#   python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Generate an OTA / fallback-AP password:
#   python3 -c "import secrets; print(secrets.token_urlsafe(16))"

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
# BSSID of the AP radio the terminal pins itself to (see the wifi: block in
# coach-terminal.yaml). Find it in the ESPHome log line "Connected, BSSID ...".
wifi_bssid: "AA:BB:CC:DD:EE:FF"
fallback_ap_password: "GENERATE_ME"
api_encryption_key: "GENERATE_ME_BASE64_32_BYTES"
ota_password: "GENERATE_ME"
